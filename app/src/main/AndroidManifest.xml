<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ── Permissions required by WorkManager Workers ─────────────────────── -->

    <!-- Required by: SyncLogsWorker, AnalyticsSyncWorker, CombineAndUploadWorker -->
    <!-- WorkManager will also enforce this via NetworkType constraint,       -->
    <!-- but explicit permission is needed for actual network calls.          -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Required by: VideoExportWorker (foreground service notification)     -->
    <!-- Mandatory on Android 13+ (API 33+) to show any notification.        -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Required by: VideoExportWorker (long-running foreground worker)      -->
    <!-- WorkManager's foreground service internally requires this permission -->
    <!-- when setForeground(ForegroundInfo) is called.                        -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Required by: VideoExportWorker specifically (uses mediaProcessing     -->
    <!-- foreground service type, introduced in Android 14 / API 34).         -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".WorkManagerDemoApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WorkManagerDemo"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.WorkManagerDemo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ── Disable Auto-Initialization of WorkManager ──────────────────── -->
        <!-- By default, WorkManager is initialized automatically via            -->
        <!-- androidx.startup.InitializationProvider when the app starts.        -->
        <!-- We REMOVE this automatic initializer here so we can provide a       -->
        <!-- custom Configuration (with our HiltWorkerFactory) in Application.  -->
        <!-- This is required for Phase 5 (Custom WorkerFactory / Hilt DI).     -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
